{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Update Kafka message-type dependencies only to globally compatible PROD versions",
  "customDatasources": {
    "jeap-message-contracts": {
      "defaultRegistryUrlTemplate": "{{ variables.JEAP_MCS_PROD_BASE_URL }}/api/renovate/message-types/{{packageName}}?currentValue={{currentValue}}&environment=PROD",
      "format": "json"
    }
  },
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "matchDatasources": ["maven"],
      "matchPackageNames": ["/\\.messagetype\\./"],
      "enabled": true,
      "overrideDatasource": "custom.jeap-message-contracts",
      "registryUrls": [],
      "versioning": "semver",
      "groupName": "Kafka message contracts",
      "groupSlug": "kafka-message-contracts",
      "minimumReleaseAge": null
    }
  ]
}
