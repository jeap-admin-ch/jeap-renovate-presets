{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "groupName": "All dependencies",
      "groupSlug": "all",
      "matchManagers": ["*"],
      "matchDepTypes": ["*"]
    }
  ],
  "vulnerabilityAlerts": {
    "groupName": "All dependencies",
    "branchTopic": "all"
  },
  "prHourlyLimit": 1,
  "prConcurrentLimit": 1
}
