{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Bump Maven project version and update existing CHANGELOG.md after Maven and Docker updates. Apply Spotless where configured after Maven/Wrapper updates. Runs once per branch; Maven steps require a root pom.xml.",
  "postUpgradeTasks": {
    "executionMode": "branch",
    "dataFileTemplate": "{{{ toJSON upgrades }}}",
    "commands": [
      "curl -sSf -o /tmp/post-upgrade.sh 'https://raw.githubusercontent.com/jeap-admin-ch/jeap-renovate-presets/main/scripts/post-upgrade.sh'",
      "chmod +x /tmp/post-upgrade.sh",
      "/tmp/post-upgrade.sh"
    ],
    "fileFilters": [
      "pom.xml",
      "**/pom.xml",
      "CHANGELOG.md",
      "**/*.java"
    ]
  }
}
